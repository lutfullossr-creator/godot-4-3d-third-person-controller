var _mc := {}
var _tc := {}

func build(parent: Node3D, with_lights: bool = false) -> void:
	var body := StaticBody3D.new()
	body.collision_layer = 1
	body.collision_mask = 0
	parent.add_child(body)
	if with_lights:
		for l in LIGHTS:
			var ol := OmniLight3D.new()
			ol.position = Vector3(l[0], l[1], l[2])
			ol.omni_range = l[3]
			ol.light_energy = l[4]
			ol.light_color = Color(l[5], l[6], l[7])
			parent.add_child(ol)
	for t in DATA:
		var arr: PackedFloat32Array = DATA[t]
		var n := int(arr.size() / 7)
		var solid: bool = not (t in NOCOL)
		var mesh: Mesh
		match SHAPE.get(t, "box"):
			"sph":
				var sm := SphereMesh.new()
				sm.radius = 0.5
				sm.height = 1.0
				sm.radial_segments = 10
				sm.rings = 6
				mesh = sm
			"cyl":
				var cm := CylinderMesh.new()
				cm.top_radius = 0.5
				cm.bottom_radius = 0.5
				cm.height = 1.0
				cm.radial_segments = 8
				mesh = cm
			"cone":
				var cn := CylinderMesh.new()
				cn.top_radius = 0.0
				cn.bottom_radius = 0.5
				cn.height = 1.0
				cn.radial_segments = 8
				mesh = cn
			_:
				var bm := BoxMesh.new()
				bm.size = Vector3.ONE
				mesh = bm
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = mesh
		mm.instance_count = n
		for i in range(n):
			var o := i * 7
			var pos := Vector3(arr[o], arr[o + 1], arr[o + 2])
			var sz := Vector3(arr[o + 3], arr[o + 4], arr[o + 5])
			var bas := Basis(Vector3.BACK, deg_to_rad(arr[o + 6])) * Basis.from_scale(sz)
			mm.set_instance_transform(i, Transform3D(bas, pos))
			if solid:
				_cshape(body, pos, sz, arr[o + 6])
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		mmi.material_override = _mat_for(t)
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if not solid else GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		parent.add_child(mmi)

# Osmon + quyosh + tuman. Agar o’yinda allaqachon WorldEnvironment bo’lsa, buni chaqirmang.
func add_environment(parent: Node, shadows: bool = false) -> void:
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.2, 0.4, 0.75)
	sky_mat.sky_horizon_color = Color(0.72, 0.82, 0.92)
	sky_mat.ground_horizon_color = Color(0.55, 0.52, 0.45)
	sky_mat.ground_bottom_color = Color(0.3, 0.3, 0.28)
	var sky := Sky.new()
	sky.sky_material = sky_mat
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.fog_enabled = true
	env.fog_light_color = Color(0.72, 0.8, 0.9)
	env.fog_density = 0.0015
	var we := WorldEnvironment.new()
	we.environment = env
	parent.add_child(we)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-50, 30, 0)
	sun.light_energy = 1.1
	sun.shadow_enabled = shadows
	sun.directional_shadow_max_distance = 80.0
	parent.add_child(sun)

func _cshape(body: StaticBody3D, c: Vector3, s: Vector3, ang: float) -> void:
	var cs := CollisionShape3D.new()
	var sh := BoxShape3D.new()
	sh.size = s
	cs.shape = sh
	cs.position = c
	cs.rotation.z = deg_to_rad(ang)
	body.add_child(cs)

func _mat_for(t: String) -> StandardMaterial3D:
	if _mc.has(t):
		return _mc[t] as StandardMaterial3D
	var m := StandardMaterial3D.new()
	m.albedo_color = COL[t]
	m.roughness = 0.92
	if TEX.has(t):
		m.albedo_texture = _tex(TEX[t][0])
		m.uv1_triplanar = true
		m.uv1_world_triplanar = true
		var sc: float = TEX[t][1]
		m.uv1_scale = Vector3(sc, sc, sc)
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	if t == "x":
		m.emission_enabled = true
		m.emission = COL[t]
		m.emission_energy_multiplier = 1.6
	if t == "fw":
		m.roughness = 0.05
		m.metallic = 0.3
	if t in ["k", "ba", "dm", "v", "V", "C"]:
		m.roughness = 0.45
		m.metallic = 0.35
	_mc[t] = m
	return m

func _tex(kind: String) -> ImageTexture:
	if _tc.has(kind):
		return _tc[kind] as ImageTexture
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(kind)
	var img := Image.create_empty(128, 128, false, Image.FORMAT_RGB8)
	for y in range(128):
		for x in range(128):
			var v := _pat(kind, x, y, rng)
			img.set_pixel(x, y, Color(v, v, v))
	img.generate_mipmaps()
	var tx := ImageTexture.create_from_image(img)
	_tc[kind] = tx
	return tx

func _pat(k: String, x: int, y: int, r: RandomNumberGenerator) -> float:
	var n := r.randf() * 0.1
	match k:
		"brick":
			var row := int(y / 16)
			var xx := (x + (row % 2) * 16) % 32
			if y % 16 < 2 or xx < 2:
				return 0.5 + n
			return 0.78 + n + float((row * 7 + int((x + (row % 2) * 16) / 32) * 13) % 5) * 0.025
		"plaster", "concrete":
			return 0.84 + n * 0.8 + 0.04 * sin(x * 0.2) * sin(y * 0.17)
		"wood":
			if x % 32 < 1:
				return 0.5
			return 0.8 + 0.1 * sin(y * 0.5 + float(int(x / 32)) * 3.0) + n * 0.6
		"metal":
			return 0.55 + 0.35 * float(int(x / 8) % 2) + n * 0.5
		"tile":
			var row2 := int(y / 8)
			var xx2 := (x + (row2 % 2) * 8) % 16
			if y % 8 < 1 or xx2 < 1:
				return 0.45
			return 0.75 + n
		"asphalt":
			return 0.72 + n * 1.5
		"paving":
			if x % 32 < 1 or y % 32 < 1:
				return 0.55
			return 0.82 + n
		"grass":
			return 0.72 + n * 2.0 + 0.08 * sin(x * 0.6) * sin(y * 0.5)
		"sand":
			return 0.88 + n
		"leaf":
			return 0.7 + n * 2.5
		"bark":
			return 0.6 + 0.3 * absf(sin(x * 0.9 + sin(y * 0.1) * 2.0)) + n
	return 0.8
